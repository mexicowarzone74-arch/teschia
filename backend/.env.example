# Base de datos PostgreSQL
# LOCAL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tescha_db
DB_USER=postgres
DB_PASSWORD=tu_password

# SUPABASE (producción) - usa DATABASE_URL en lugar de las variables individuales:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# JWT
JWT_SECRET=tu_secreto_super_seguro_cambialo_en_produccion
JWT_EXPIRES_IN=7d

# Servidor
PORT=5000
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# Motor IA Python
AI_ENGINE_URL=http://localhost:8000

# 🔒 SEGURIDAD Y ALERTAS
# Email para recibir alertas de seguridad
SECURITY_ALERT_EMAIL=admin@tescha.com

# Habilitar alertas por email (true/false)
ENABLE_EMAIL_ALERTS=true

# Configuración SMTP para envío de emails
# Para Gmail: Usa una "Contraseña de aplicación" (no tu contraseña normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_aplicacion_de_16_caracteres

# Clave de encriptación (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=generar_clave_de_32_bytes_en_hexadecimal
