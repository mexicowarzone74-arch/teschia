# ──────────────────────────────────────────────
# VARIABLES DE ENTORNO - FRONTEND (Vite)
# ──────────────────────────────────────────────
# Estas variables se configuran en Cloudflare Pages > Settings > Environment Variables

# URL completa del backend CON /api (para axios en api.js)
# LOCAL:
VITE_API_URL=http://localhost:5000/api
# PRODUCCIÓN (Render):
# VITE_API_URL=https://tescha-backend.onrender.com/api

# URL base del backend SIN /api (para Socket.io y fetch directos)
# LOCAL:
VITE_BACKEND_URL=http://localhost:5000
# PRODUCCIÓN (Render):
# VITE_BACKEND_URL=https://tescha-backend.onrender.com
